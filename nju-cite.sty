\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{nju-cite}[2026/10/29 NJU presentation citation helpers]

% ICLR-style author-year citations: (Author, Year), semicolon separated.
\RequirePackage{natbib}
\setcitestyle{authoryear,round,citesep={;},aysep={,},yysep={;}}

% beamer makes \citet/\citep fragile; make them robust once here.
\RequirePackage{etoolbox}
\MakeRobust{\citet}
\MakeRobust{\citep}

% Optional file generated by make_shortrefs.py from the .bib file.
\IfFileExists{shortrefs.tex}{\input{shortrefs}}{}

\newcommand{\njushortref}[1]{%
  \ifcsname shortref@#1\endcsname
    \csname shortref@#1\endcsname
  \else
    \citeauthor{#1} (\citeyear{#1})%
  \fi}

\let\origcitet\citet
\let\origcitep\citep
\renewcommand{\citet}[1]{%
  \textcolor{NJUGoldDark}{\origcitet{#1}}%
  \begingroup
  \renewcommand{\thefootnote}{}%
  \footnotetext{\njushortref{#1}}%
  \endgroup}
\renewcommand{\citep}[1]{\textcolor{NJUGoldDark}{\origcitep{#1}}}

\endinput
